{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "allowImportingTsExtensions": true,

    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",

    "types": ["node"],

    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",

    "skipLibCheck": true
  },
  "include": ["src"]
}
